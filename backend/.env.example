# Development only. Copy to backend/.env. Production settings: docs/DEPLOYMENT.md
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Generate your own secret before production, do not use a shared example key.
# DJANGO_SECRET_KEY=
# DJANGO_DB_PATH=/absolute/path/to/db.sqlite3
# DJANGO_MEDIA_ROOT=/absolute/path/to/media
# Optional user-provided Chinese idiom lexicon (UTF-8, one entry per line).
# RUCORPUS_IDIOMS_PATH=/absolute/path/to/idioms.txt
